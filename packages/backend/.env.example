# .env.example
NODE_ENV=example
MONGODB_USER=user
MONGODB_PASSWORD=password
MONGODB_HOST=localhost
MONGODB_PORT=27017
DB_NAME=avalon-example
SECRET_KEY=example-key

# Set real secrets in the process environment or ignored .env.local, never in source control.

# Password recovery / Yandex Cloud Postbox. Disabled until configured.
MAIL_ENABLED=false
POSTBOX_SMTP_USER=
POSTBOX_SMTP_PASSWORD=
MAIL_FROM=security@avalon-game.com
MAIL_FRONTEND_URL=https://avalon-game.com
# Independent 32-byte key, encoded as 64 hex characters. Never reuse SECRET_KEY.
MAIL_ENCRYPTION_KEY=
# Separate secret for the authenticated Postbox event bridge, at least 32 characters.
MAIL_EVENT_SECRET=
MAIL_TEST_RECIPIENTS=
MAIL_HOURLY_LIMIT=1000
MAIL_DAILY_LIMIT=5000
# Explicit IPs/CIDRs of your reverse proxy. Leave empty when accessed directly.
TRUSTED_PROXY_CIDRS=

# Direct crypto support. Enable only after testing the read APIs from your server.
DIRECT_SUPPORT_ENABLED=false
SUPPORT_BTC_API_URL=https://mempool.space/api
SUPPORT_TRON_API_URL=https://api.trongrid.io
SUPPORT_ETH_RPC_URL=https://ethereum-rpc.publicnode.com
SUPPORT_BSC_RPC_URL=https://bsc-rpc.publicnode.com
# Optional for higher TronGrid quotas; server-only.
SUPPORT_TRON_API_KEY=
# Public receiving addresses; defaults also live in support/direct/config.ts.
SUPPORT_BTC_ADDRESS=bc1qn63r5d5qd0rnq7l9v2kp75rx9c5jsh9m22v09ru9dy3t3hutt8zqksv2nv
SUPPORT_TRON_ADDRESS=TLmpR98uorxHmAULuG5JwDpaxKv7j5Zmvq
SUPPORT_ETH_ADDRESS=0xE37cA64A14dD8e92929B7E71f3DA32267Da5969a
SUPPORT_BSC_ADDRESS=0xE37cA64A14dD8e92929B7E71f3DA32267Da5969a
