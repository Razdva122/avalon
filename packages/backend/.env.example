# Шаблон для backend. Скопируйте нужные параметры в .env.local
# или передайте их контейнеру. Значения ниже — примеры, не production-секреты.
# Описание и порядок загрузки: docs/environment.md

# Режим запуска: development или production.
NODE_ENV=development

# Подключение к MongoDB.
MONGODB_HOST=localhost
MONGODB_PORT=27017
DB_NAME=avalon-example
MONGODB_USER=user
MONGODB_PASSWORD=password

# Ключ подписи токенов авторизации. Для production задайте свой секрет.
SECRET_KEY=replace-with-your-secret

# Восстановление пароля через Yandex Cloud Postbox. Без настроек выключено.
# Для включения нужны ВСЕ шесть параметров ниже и MAIL_ENABLED=true.
# MAIL_ENABLED=true
# POSTBOX_SMTP_USER=
# POSTBOX_SMTP_PASSWORD=
# MAIL_FROM=security@avalon-game.com
# MAIL_FRONTEND_URL=https://avalon-game.com
# Отдельный ключ: 64 hex-символа; не использовать SECRET_KEY.
# MAIL_ENCRYPTION_KEY=
# Отдельный секрет обработчика событий Postbox: минимум 32 символа.
# MAIL_EVENT_SECRET=

# Необязательные ограничения почты (показаны значения по умолчанию).
# MAIL_HOURLY_LIMIT=1000
# MAIL_DAILY_LIMIT=5000
# Адреса через запятую; если не задано, отправка не ограничена тестовым списком.
# MAIL_TEST_RECIPIENTS=

# IP/CIDR доверенного reverse proxy, через запятую. Без прокси не требуется.
# TRUSTED_PROXY_CIDRS=

# Донаты работают без параметров: API и кошельки уже заданы в коде.
# Необязательные переопределения описаны в docs/payments/direct-crypto.md.

# Эксперимент AI Avalon; подробнее docs/ai-rooms.md. По умолчанию выключен.
# AI_ROOMS_ENABLED=true
# YANDEX_API_KEY=
# YANDEX_MODEL=qwen3.6-35b-a3b
# YANDEX_FOLDER_ID=
# AI_ROOM_ADMIN_LOGINS=razdva
# Общий накопительный потолок и потолок партии; допускается только уменьшение.
# AI_TOTAL_BUDGET_RUB=500
# AI_MATCH_BUDGET_RUB=50
