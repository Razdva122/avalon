# .env.example
NODE_ENV=example
MONGODB_USER=user
MONGODB_PASSWORD=password
MONGODB_HOST=localhost
MONGODB_PORT=27017
DB_NAME=avalon-example
SECRET_KEY=example-key

# OxaPay: leave the key empty until the merchant account is configured.
# Set real secrets in the process environment or ignored .env.local, never in source control.
OXAPAY_MERCHANT_API_KEY=
OXAPAY_SANDBOX=true
OXAPAY_CALLBACK_URL=https://avalon-game.com/api/support/oxapay/ipn
SUPPORT_FRONTEND_URL=https://avalon-game.com

# Password recovery / Yandex Cloud Postbox. Disabled until configured.
MAIL_ENABLED=false
POSTBOX_SMTP_USER=
POSTBOX_SMTP_PASSWORD=
MAIL_FROM=security@avalon-game.com
MAIL_FRONTEND_URL=https://avalon-game.com
# Independent 32-byte key, encoded as 64 hex characters. Never reuse SECRET_KEY.
MAIL_ENCRYPTION_KEY=
# Separate secret for the authenticated Postbox event bridge, at least 32 characters.
MAIL_EVENT_SECRET=
MAIL_TEST_RECIPIENTS=
MAIL_HOURLY_LIMIT=1000
MAIL_DAILY_LIMIT=5000
# Explicit IPs/CIDRs of your reverse proxy. Leave empty when accessed directly.
TRUSTED_PROXY_CIDRS=
