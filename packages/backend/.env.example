# .env.example
NODE_ENV=example
MONGODB_USER=user
MONGODB_PASSWORD=password
MONGODB_HOST=localhost
MONGODB_PORT=27017
DB_NAME=avalon-example
SECRET_KEY=example-key

# NOWPayments: leave empty until the merchant account and networks are configured.
# Set real secrets in the process environment or ignored .env.local, never in source control.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_CALLBACK_URL=https://avalon-game.com/api/support/nowpayments/ipn
SUPPORT_FRONTEND_URL=https://avalon-game.com
# Comma-separated USDT currency codes verified in your NOWPayments account.
NOWPAYMENTS_USDT_CURRENCIES=usdttrc20,usdterc20,usdtbsc
