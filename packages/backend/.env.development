# Локальная разработка. Не используйте эти учетные данные в production.
# Описание параметров: docs/environment.md

# Режим запуска
NODE_ENV=development

# Подключение к MongoDB
MONGODB_HOST=localhost
MONGODB_PORT=27017
DB_NAME=avalon-dev
MONGODB_USER=admin
MONGODB_PASSWORD=secret

# Ключ подписи токенов авторизации. Не менять без необходимости.
SECRET_KEY=dev-key

# Донаты работают со встроенными API и адресами кошельков.
# Почта по умолчанию выключена; настройки см. в .env.example.
