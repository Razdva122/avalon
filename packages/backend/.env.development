# .env.development
NODE_ENV=development
MONGODB_USER=admin
MONGODB_PASSWORD=secret
MONGODB_HOST=localhost
MONGODB_PORT=27017
DB_NAME=avalon-dev
SECRET_KEY=dev-key

# NOWPayments: leave empty until the merchant account and networks are configured.
# Set real secrets in the process environment or ignored .env.local, never in source control.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_CALLBACK_URL=https://avalon-game.com/api/support/nowpayments/ipn
# Comma-separated USDT currency codes verified in your NOWPayments account.
NOWPAYMENTS_USDT_CURRENCIES=usdttrc20,usdterc20,usdtbsc

# Direct crypto support (mainnet wallets, local application database)
DIRECT_SUPPORT_ENABLED=true
SUPPORT_BTC_API_URL=https://mempool.space/api
SUPPORT_TRON_API_URL=https://api.trongrid.io
SUPPORT_ETH_RPC_URL=https://ethereum-rpc.publicnode.com
SUPPORT_BSC_RPC_URL=https://bsc-rpc.publicnode.com
