{
  "name": "@avalon/ui",
  "version": "64.1.0",
  "private": true,
  "scripts": {
    "preserve": "npm run generate:avatars && node scripts/generate-locales.cjs",
    "serve": "vue-cli-service serve",
    "prebuild": "npm run generate:avatars && node scripts/generate-locales.cjs",
    "test": "node --test scripts/*.test.cjs",
    "build": "npm test && vue-cli-service build && node scripts/critical-css.cjs && npm run check:build",
    "check:build": "node scripts/check-seo.cjs && node --test scripts/check-structured-data.cjs && node scripts/check-seo-navigation.cjs && node scripts/check-bundle.cjs && node scripts/check-images.cjs && node scripts/check-password-recovery.cjs && node scripts/check-support.cjs && node scripts/check-startup.cjs",
    "check:seo:nginx": "node scripts/check-seo-nginx.cjs",
    "check:seo:http": "node scripts/check-seo-http.cjs",
    "upload:images": "node scripts/upload-images.cjs",
    "generate:avatars": "node scripts/generate-avatars.cjs"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.6",
    "@vueuse/core": "^13.1.0",
    "axios": "^1.6.2",
    "chart.js": "^4.4.8",
    "chartjs-plugin-annotation": "^3.1.0",
    "core-js": "^3.34.0",
    "js-cookie": "^3.0.5",
    "locale": "^0.1.0",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.7.2",
    "uuid": "^9.0.1",
    "vue": "^3.3.11",
    "vue-chartjs": "^5.3.2",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.2.5",
    "vuetify": "^3.5.6",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@prerenderer/renderer-puppeteer": "^1.2.3",
    "@prerenderer/webpack-plugin": "^5.3.9",
    "@types/js-cookie": "^3.0.6",
    "@types/locale": "^0.1.4",
    "@types/qrcode": "^1.5.6",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-router": "~5.0.0",
    "@vue/cli-plugin-typescript": "~5.0.0",
    "@vue/cli-plugin-vuex": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "beasties": "^0.4.2",
    "copy-webpack-plugin": "^12.0.2",
    "jsqr": "^1.4.0",
    "material-design-icons-iconfont": "^6.7.0",
    "puppeteer": "^22.5.0",
    "sass": "^1.69.5",
    "sass-loader": "^12.6.0",
    "sharp": "0.34.5",
    "sitemap-webpack-plugin": "^1.1.1",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^5.1.4",
    "webpack-plugin-vuetify": "^3.0.4"
  }
