# Merge into the backend service environment. Supply secrets from the deployment secret store.
NODE_ENV=production
AI_ROOMS_ENABLED=true
AI_TOTAL_BUDGET_RUB=3000
AI_MATCH_BUDGET_RUB=150
AI_REASONING=default
YANDEX_MODEL=qwen3.6-35b-a3b
YANDEX_FOLDER_ID=REPLACE_WITH_PRODUCTION_FOLDER
YANDEX_API_KEY=REPLACE_WITH_SECRET
# 30-day periods and 10-second pacing are selected by NODE_ENV=production.
# Do not deploy .env.local or copy local database users/tokens to production.
# Supported alternative after deploying model-registry support:
# YANDEX_MODEL=deepseek-v4-flash
# Default lobby selection only; admins can choose each new match model in the UI.
