# Merge into the backend service environment; preserve existing application secrets.
NODE_ENV=production
AI_ROOMS_ENABLED=true
# Enable after verifying the existing authenticated local or remote Codex worker.
AI_CODEX_ENABLED=false
# Choose compose-codex.fragment.yaml or compose-codex-remote.fragment.yaml.
AI_TRACE_RETENTION_DAYS=30
AI_REQUEST_RETENTION_DAYS=365
# Do not deploy .env.local or copy local users/tokens to production.
